{
  "name": "drift-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "RANCH", "class_name": "RanchDO" }]
  },
  "exports": {
    "RanchDO": { "type": "durable-object", "storage": "sqlite" }
  }
}
